public class MaximumProductSubarray {
	public int maxProduct(int[] nums) {
		int currMin = nums[0];
        int currMax = nums[0];
        int maxProd = nums[0];
     // Iterate through the array starting from the second element
        for (int i = 1; i < nums.length; i++) {
            int current = nums[i];

            // If current number is negative, max and min products swap roles
            if (current < 0) {
                int temp = currMax;
                currMax = currMin;
                currMin = temp;
            }

            // Calculate new max and min products ending at the current index
            currMax = Math.max(current, currMax * current);
            currMin = Math.min(current, currMin * current);

            // Update the global maximum product found so far
            maxProd = Math.max(maxProd, currMax);
        }
        return maxProd;
	}
	public static void main(String[] args) {
		MaximumProductSubarray solution = new MaximumProductSubarray();
		int[] nums = { 2,3,-2,4 };
		int maxSum = solution.maxProduct(nums);
		System.out.println("Maximum product subarray: " + maxSum); 
	}
}


